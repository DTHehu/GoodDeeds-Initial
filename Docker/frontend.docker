# Stage 1: Build Environment
FROM node:20-alpine AS builder

WORKDIR /app

# Cache dependencies layer
# Why: Copying package files first prevents a full 'npm install' on every minor code change.
COPY package.json package-lock.json ./
RUN npm ci

# Copy the source code and compile
COPY . .
RUN npm run build 

# Stage 2: Production Environment
FROM nginx:alpine

# Why: Clears out default placeholder pages to prevent conflicts
RUN rm -rf /usr/share/nginx/html/*

# Copy only the compiled artifacts from the builder stage
# Why: Leaves the heavy Node toolchain and raw source code behind
COPY --from=builder /app/build /usr/share/nginx/html

# Optional but recommended: Copy a custom Nginx config for SPA routing
# COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
